# Runtime LLM provider. Exact model should be selected/configured during implementation/evals.
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=

# Safety/runtime defaults; implementation may refine these based on provider behavior and eval traces.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Short bounded backoff base (seconds) between transient-failure retries.
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_TEMPERATURE=0
AGENT_MAX_STEPS=

# Optional path to an authorized local copy of the supplied Quest 4 Stage 1 starter kit.
QUEST4_STARTER_KIT_PATH=.vendor/place-il-quests/Quest 4/Stage 1/starter-kit

# Optional pricing config for estimated-cost reporting; keep mutable pricing out of agent logic.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
