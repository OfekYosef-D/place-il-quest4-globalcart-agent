# Active runtime provider/model. Put secrets only in local .env (never Git).
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3.5-397b-a17b
OPENROUTER_API_KEY=

# Optional legacy/alternate provider credential. Only needed with LLM_PROVIDER=groq.
GROQ_API_KEY=

# Safety/runtime defaults.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
LLM_TEMPERATURE=0
LLM_REASONING_EFFORT=
AGENT_MAX_STEPS=

# Stage 1 starter kit (single-agent baseline remains runnable unchanged).
QUEST4_STARTER_KIT_PATH=.vendor/place-il-quests/Quest 4/Stage 1/starter-kit

# Stage 2 starter kit and per-specialist loop ceiling.
QUEST4_STAGE2_STARTER_KIT_PATH=.vendor/place-il-quests-stage2/Quest 4/Stage 2/starter-kit
CREW_AGENT_MAX_STEPS=6

# Optional real Slack delivery for Stage 2. The supplied tool still writes its
# deterministic outbox when no webhook is configured.
SLACK_WEBHOOK_URL=

# Local interactive demo server.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# Optional single-model pricing config for ad-hoc CLI runs. The eval runner
# overrides these from evals/candidates.json when candidate prices are pinned.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
